# Database Configuration
# Get from Neon Console (https://console.neon.tech)
# Format: postgresql://username:password@host/database
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb

# Auth0 Configuration
# Get from Auth0 Dashboard (https://manage.auth0.com)
AUTH0_DOMAIN=dev-xxxxx.us.auth0.com
AUTH0_AUDIENCE=https://api.example.com
AUTH0_CLIENT_ID=your_auth0_client_id_here
AUTH0_CLIENT_SECRET=your_auth0_client_secret_here
AUTH0_BASE_URL=http://localhost:3000

# JWT Secret for TA Authentication
# Generate a secure random string (min 32 characters)
TA_JWT_SECRET=your-super-secret-random-string-min-32-chars

# Email Configuration (Gmail with App Password)
# 1. Enable 2FA on Gmail account
# 2. Generate App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password-here

# Frontend URL (for Vercel preview deployments)
FRONTEND_URL=http://localhost:5173
