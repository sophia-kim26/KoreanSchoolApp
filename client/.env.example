# API Configuration
# Point to your backend API
VITE_API_URL=http://localhost:3000

# Auth0 Configuration
# Get from Auth0 Dashboard (https://manage.auth0.com)
# Must match server AUTH0_DOMAIN and AUTH0_AUDIENCE
VITE_AUTH0_DOMAIN=dev-xxxxx.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id_here
VITE_AUTH0_AUDIENCE=https://api.example.com
